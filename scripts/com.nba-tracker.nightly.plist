<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the nightly ingestion.

  Install:
    cp scripts/com.nba-tracker.nightly.plist ~/Library/LaunchAgents/
    launchctl load  ~/Library/LaunchAgents/com.nba-tracker.nightly.plist

  Check / run by hand / remove:
    launchctl list | grep nba-tracker
    launchctl start com.nba-tracker.nightly
    launchctl unload ~/Library/LaunchAgents/com.nba-tracker.nightly.plist

  Why 8am and not overnight: games on the East Coast finish around 1am ET,
  which is 10pm Pacific, so nothing requires an overnight run. 8am is a time
  the machine is awake, which removes the need for pmset wake scheduling.

  If the Mac is asleep at 8am, launchd runs the job on the next wake. If it was
  shut down, the run is skipped entirely — and that is fine, because the job is
  self-healing: --catch-up collects every game the warehouse is missing, not
  just yesterday's. Missing a day costs latency, never data.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nba-tracker.nightly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/timato/Documents/nba-tracker/scripts/nightly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/timato/Documents/nba-tracker</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Both streams to one file, so the log reads in the order things happened. -->
    <key>StandardOutPath</key>
    <string>/Users/timato/Documents/nba-tracker/logs/nightly.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/timato/Documents/nba-tracker/logs/nightly.log</string>

    <!-- Do not restart on exit: this is a scheduled batch job, not a daemon. -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
