# Copy to .env and adjust. .env is gitignored; this template is committed.

POSTGRES_USER=nba
POSTGRES_PASSWORD=nba_dev_password
POSTGRES_DB=nba_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Single connection string used by the ingestion, transform and dashboard code.
# Swap this one line for the Supabase/Neon URL in step 4 — nothing else changes.
DATABASE_URL=postgresql://nba:nba_dev_password@localhost:5432/nba_tracker
