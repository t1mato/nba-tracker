# Copy to .env and adjust. .env is gitignored; this template is committed.

# Local dev Postgres (docker-compose.yml). Still used as the TEST database —
# see TEST_DATABASE_URL below.
POSTGRES_USER=nba
POSTGRES_PASSWORD=nba_dev_password
POSTGRES_DB=nba_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# The warehouse. Ingestion, transforms, checks and the dashboard all read this
# one variable, which is why moving from local Docker to a hosted Neon instance
# was a one-line change.
#
#   local:  postgresql://nba:nba_dev_password@localhost:5432/nba_tracker
#   neon:   postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://nba:nba_dev_password@localhost:5432/nba_tracker

# Database for the transform tests, which CREATE and DROP a throwaway database
# per run. Neon's free tier does not permit CREATE DATABASE, so once DATABASE_URL
# points at Neon the tests need a local Postgres here. Unset and they fall back
# to DATABASE_URL (and skip if that cannot create a database).
TEST_DATABASE_URL=postgresql://nba:nba_dev_password@localhost:5432/nba_tracker
